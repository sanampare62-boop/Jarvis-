<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Glowing Cyberpunk Error Emblem -->
    <TextView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/ic_launcher_foreground"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:text="@string/error_offline_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/error_offline_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Retry Action Button -->
    <Button
        android:id="@+id/btnRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/cyan_primary"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:text="@string/btn_retry"
        android:textColor="@color/bg_dark"
        android:textStyle="bold" />

    <!-- Configure Server URL Button -->
    <Button
        android:id="@+id/btnConfigServer"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_settings"
        android:textColor="@color/cyan_light"
        android:textSize="12sp" />

</LinearLayout>
