<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.JarvisMahi" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/cyan_primary</item>
        <item name="colorPrimaryVariant">@color/cyan_light</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/pink_accent</item>
        <item name="colorSecondaryVariant">@color/purple_accent</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/bg_darker</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/bg_darker</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
</resources>
